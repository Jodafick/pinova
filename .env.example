# API (optionnel ; défaut = backend Render du projet)
# VITE_API_BASE_URL=https://api.example.com

# Client OAuth Google (optionnel ; sinon valeur par défaut du dépôt)
# VITE_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com

# Page Contact (mailto)
# VITE_CONTACT_EMAIL=hello@votredomaine.com

# PostHog EU (analytics produit — optionnel)
# VITE_POSTHOG_KEY=phc_xxx
# VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Feature flags A/B (override forcé ; sinon bucketing 50 %)
# VITE_FEATURE_ONBOARDING_V2=true
